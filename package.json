{
  "name": "beat-clipper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-core": "node scripts/copy-ffmpeg-core.mjs",
    "predev": "npm run copy-core",
    "dev": "vite",
    "prebuild": "npm run copy-core",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "web-audio-beat-detector": "^8.2.10"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
